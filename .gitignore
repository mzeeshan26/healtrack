# --- Environment / Secrets ---
# Never commit credentials or local environment settings
!.env.example
!**/.env.example
.env.development.local
.env.test.local
.env.production.local
*.pem
secrets.json

# --- OS Generated Files ---
# Ignore system-specific files like macOS folder metadata
.DS_Store
Thumbs.db

# --- Dependencies & Build Folders ---
# Ignore large dependency folders (Node.js, Python, etc.)
node_modules/
venv/
.venv/
__pycache__/
build/
dist/
out/

# --- Log Files ---
# Ignore log outputs that change frequently
*.log
npm-debug.log*
yarn-debug.log*

# --- IDE & Editor Settings ---
# Ignore personal editor configurations
.vscode/
.idea/
*.swp
*.iml
config.bat
